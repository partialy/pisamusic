# 复制为 /www/wwwroot/cert/qiniu-cert.env，并设置 chmod 600。
# 不要把真实值提交到 Git 或发送到聊天中。
# Cloudflare API Token；脚本会将 CF_API_TOKEN 映射给 acme.sh 的 CF_Token。
CF_API_TOKEN=replace-with-cloudflare-dns-edit-token
QINIU_ACCESS_KEY=replace-with-qiniu-ak
QINIU_SECRET_KEY=replace-with-qiniu-sk
QINIU_PRIVATE_DOMAIN=qiniu-private-oss.partialy.cn
QINIU_PUBLIC_DOMAIN=qiniu-public-oss.partialy.cn
ACME_HOME=/root/.acme.sh
