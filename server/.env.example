QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_UPLOAD_URL=https://upload.qiniup.com
# 私有空间（CDN 域名）
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_DOMAIN_CDN=
# 公开图片空间（CDN 域名）
QINIU_PUBLIC_IMAGE_BUCKET=
QINIU_PUBLIC_IMAGE_DOMAIN=
QINIU_PUBLIC_IMAGE_DOMAIN_CDN=
# 公开文件空间（预留，暂未启用）
# QINIU_PUBLIC_FILE_BUCKET=
# QINIU_PUBLIC_FILE_DOMAIN=
# QINIU_PUBLIC_FILE_DOMAIN_CDN=
# 官网统计访客 ID 哈希盐；生产必须设置独立随机值
ANALYTICS_HASH_SALT=
# 原始访问、下载和设备日活保留天数，允许 90-730
ANALYTICS_RETENTION_DAYS=180
# 设备专属消息读取凭证签名密钥；生产必须设置独立随机值
DEVICE_MESSAGE_JWT_SECRET=replace-with-a-long-random-secret

# App推广归因Cookie独立签名密钥；生产必填，建议随机32字节（64位hex），至少32字符
APP_SHARE_ATTRIBUTION_SECRET=

# 数据库模式：未设置默认 SQLITE；MYSQL 失败时不会回退
DB_TYPE=SQLITE
# SQLite 路径为空时为服务工作目录 data/pm.db
PISA_APP_DB_PATH=
# MySQL 5.7 空库；特殊字符请 URL 编码；禁止在此提交真实密码
MYSQL_URL=mysql://pisa_music:replace-password@127.0.0.1:3306/pisa_music
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT_MS=10000
# SQLite 完整备份 / 数据迁移文件限制
DB_MIGRATION_UPLOAD_MAX_BYTES=2147483648
DB_MIGRATION_STORAGE_MAX_BYTES=10737418240
