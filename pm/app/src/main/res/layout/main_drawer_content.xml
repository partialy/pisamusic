<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/drawerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/drawerAccountRow"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/drawer_account_open_profile"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/drawerAccountAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_pm_icon"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <TextView
                android:id="@+id/drawerAccountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:text="@string/drawer_account_login_now"
                android:textColor="@color/colorOnBgNormal"
                android:textSize="16sp"
                tools:text="PisaMusic 用户" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/drawerAccountChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_chevron_right_24"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/drawerGridTopCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/home_mini_player_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/drawerGridTopContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/drawerFeatureCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/transparent"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/drawerFixedActionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/drawerImportPlaylistsRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="@string/drawer_import_playlists"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/drawerImportPlaylistsIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                app:srcCompat="@drawable/ic_login_24"
                                app:tint="@color/colorOnBgNormal" />

                            <TextView
                                android:id="@+id/drawerImportPlaylistsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/drawer_import_playlists"
                                android:textColor="@color/colorOnBgNormal"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/drawerKgSourceTag"
                                android:layout_width="16dp"
                                android:layout_height="16dp" />

                            <TextView
                                android:id="@+id/drawerWySourceTag"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                app:srcCompat="@drawable/ic_chevron_right_24"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/drawerLinkImportRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="@string/drawer_link_import"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/drawerLinkImportIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                app:srcCompat="@drawable/ic_link_24"
                                app:tint="@color/colorOnBgNormal" />

                            <TextView
                                android:id="@+id/drawerLinkImportTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/drawer_link_import"
                                android:textColor="@color/colorOnBgNormal"
                                android:textSize="14sp" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                app:srcCompat="@drawable/ic_chevron_right_24"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/drawerSleepTimerRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="@string/drawer_sleep_timer"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/drawerSleepTimerIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                app:srcCompat="@drawable/ic_alarm_24"
                                app:tint="@color/colorOnBgNormal" />

                            <TextView
                                android:id="@+id/drawerSleepTimerTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/drawer_sleep_timer"
                                android:textColor="@color/colorOnBgNormal"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/drawerSleepTimerRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:visibility="gone"
                                tools:text="09:42"
                                tools:visibility="visible" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                app:srcCompat="@drawable/ic_chevron_right_24"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/drawerThemeRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="@string/drawer_theme_appearance"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/drawerThemeIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                app:srcCompat="@drawable/ic_sider_theme_24"
                                app:tint="@color/colorOnBgNormal" />

                            <TextView
                                android:id="@+id/drawerThemeTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/drawer_theme_appearance"
                                android:textColor="@color/colorOnBgNormal"
                                android:textSize="14sp" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/drawerThemeModeIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                app:srcCompat="@drawable/ic_sider_theme_auto_24"
                                app:tint="@color/colorOnBgSecond" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                app:srcCompat="@drawable/ic_chevron_right_24"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/drawerDynamicListSectionContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/drawerGridBottomCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/home_mini_player_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/drawerGridBottomContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/drawerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/drawerSettingsButton"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/drawer_settings"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_settings_24"
                app:tint="@color/colorOnBgNormal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/drawer_settings"
                android:textColor="@color/colorOnBgNormal"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerScanButton"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/drawer_scan"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_scan_qrcode_24"
                app:tint="@color/colorOnBgNormal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/drawer_scan"
                android:textColor="@color/colorOnBgNormal"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerFeedbackButton"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/drawer_feedback"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_sider_feedback_24"
                app:tint="@color/colorOnBgNormal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/drawer_feedback"
                android:textColor="@color/colorOnBgNormal"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
