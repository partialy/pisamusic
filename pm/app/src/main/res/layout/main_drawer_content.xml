<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/drawerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/drawerAccountRow"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/drawer_account_open_profile"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/drawerAccountAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_pm_icon"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <TextView
                android:id="@+id/drawerAccountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxWidth="92dp"
                android:maxLines="1"
                android:text="@string/drawer_account_login_now"
                android:textColor="@color/colorOnBgNormal"
                android:textSize="16sp"
                tools:text="PisaMusic 用户" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/drawerAccountChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_chevron_right_24"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/drawerSettingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/drawer_settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings_24"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/drawerScanButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/drawer_scan"
            android:padding="8dp"
            android:src="@drawable/ic_scan_qrcode_24"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/drawerFeatureCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/home_mini_player_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <LinearLayout
                android:id="@+id/drawerThirdPartyAccountsRow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <LinearLayout
                    android:id="@+id/drawerKgAccountEntry"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/drawer_kg_account_entry"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/drawerKgSourceTag"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        tools:ignore="SmallSp"
                        tools:text="K" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/drawerKgAvatar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_pm_icon"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/drawerKgNickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxWidth="48dp"
                        android:maxLines="1"
                        android:text="@string/drawer_not_logged_in"
                        android:textColor="@color/colorOnBgNormal"
                        android:textSize="13sp"
                        tools:text="酷狗用户" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/drawerKgChevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_chevron_right_24"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:background="@color/settings_card_inset_divider" />

                <LinearLayout
                    android:id="@+id/drawerWyAccountEntry"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/drawer_wy_account_entry"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/drawerWySourceTag"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        tools:ignore="SmallSp"
                        tools:text="Y" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/drawerWyAvatar"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_pm_icon"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/drawerWyNickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxWidth="48dp"
                        android:maxLines="1"
                        android:text="@string/drawer_not_logged_in"
                        android:textColor="@color/colorOnBgNormal"
                        android:textSize="13sp"
                        tools:text="网易用户" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/drawerWyChevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_chevron_right_24"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/settings_card_inset_divider" />

            <LinearLayout
                android:id="@+id/drawerImportPlaylistsRow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_playlist_24"
                    app:tint="@color/colorOnBgNormal" />

                <TextView
                    android:id="@+id/drawerImportPlaylistsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/drawer_import_playlists"
                    android:textColor="@color/colorOnBgNormal"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/drawerClearThirdPartyLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:text="@string/drawer_clear_third_party_login"
                    android:textColor="@color/account_profile_logout_text"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/settings_card_inset_divider" />

            <LinearLayout
                android:id="@+id/drawerSleepTimerRow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_alarm_24"
                    app:tint="@color/colorOnBgNormal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/drawer_sleep_timer"
                    android:textColor="@color/colorOnBgNormal"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/drawerSleepTimerRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="09:42"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
