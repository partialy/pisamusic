<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stickyPlayAllRow"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@color/home_page_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <ImageButton
        android:id="@+id/btnPlayAllSticky"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play_all"
        android:padding="8dp"
        android:src="@drawable/ic_play_24"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/trackCountTextViewSticky"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/playlist_zero_tracks"
        android:textColor="@color/home_tab_unselected"
        android:textSize="13sp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/sortPlaylistButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/playlist_detail_sort_cd"
        android:padding="8dp"
        android:src="@drawable/ic_sort_24"
        app:tint="?attr/colorOnSurfaceVariant" />

    <ImageButton
        android:id="@+id/batchPlaylistButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:alpha="0.62"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/playlist_detail_batch_cd"
        android:enabled="false"
        android:padding="8dp"
        android:src="@drawable/ic_list_check_24"
        app:tint="@color/home_tab_unselected" />
</LinearLayout>
