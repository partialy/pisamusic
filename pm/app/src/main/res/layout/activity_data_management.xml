<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dataManagementRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/home_page_bg" />

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_page_bg"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/home_page_bg"
            app:navigationIcon="@drawable/ic_back_24"
            app:title="@string/settings_import_export" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pm_page_content_start"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- Card 1: 本地数据 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDataOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/home_mini_player_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/settings_card_inset_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/data_icon_local"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pm.Corner12" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/data_overview_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 3-Column Stat Metric Tiles -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Tile 1: 收藏歌曲 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_data_stat_tile"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/overviewLovedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textStyle="bold"
                                tools:text="0 首" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/data_loved_songs_tile_title"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/overviewLovedSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?attr/colorPrimary"
                                tools:text="0 B" />
                        </LinearLayout>

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="match_parent" />

                        <!-- Tile 2: 歌单总数 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_data_stat_tile"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/overviewPlaylistCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textStyle="bold"
                                tools:text="0 个" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/data_playlist_tile_title"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/overviewPlaylistSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?attr/colorPrimary"
                                tools:text="0 B" />
                        </LinearLayout>

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="match_parent" />

                        <!-- Tile 3: 数据占用 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_data_stat_tile"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/overviewTotalSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textStyle="bold"
                                tools:text="0 B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/data_storage_tile_title"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?android:attr/textColorSecondary" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Inset Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/settings_card_inset_divider" />

                    <!-- Clear all data action button row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDeleteAll"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="0dp"
                            android:text="@string/data_delete_button"
                            android:textColor="@color/red"
                            android:textSize="12sp"
                            app:backgroundTint="@color/listen_together_leave_bg"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: 歌单与收藏 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDataBackupRestore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/home_mini_player_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/settings_card_inset_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/data_icon_playlist"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pm.Corner12" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/data_backup_restore_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportBackup"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp"
                        android:text="@string/data_import_button"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportBackup"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp"
                        android:text="@string/data_export_button"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: 播放日志 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDataDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/home_mini_player_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/settings_card_inset_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/data_icon_diagnostics"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pm.Corner12" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/data_diagnostics_card_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportDiagnostics"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp"
                        android:text="@string/data_diagnostics_export_button"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: 故障上报 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaultReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/home_mini_player_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/settings_card_inset_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/settings_ic_fault_report"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Pm.Corner12" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/fault_report_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/reportNowButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="0dp"
                            android:text="@string/fault_report_now"
                            android:textSize="12sp"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_data_stat_tile"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/faultTotalCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textStyle="bold"
                                tools:text="0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/fault_report_total_label"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_data_stat_tile"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/faultRecentCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textStyle="bold"
                                tools:text="0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/fault_report_recent_label"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_data_stat_tile"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/faultPendingCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textStyle="bold"
                                tools:text="0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/fault_report_pending_label"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/faultLatestErrorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="最近错误：暂无" />

                    <TextView
                        android:id="@+id/faultLastReportText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="上次上报：暂无" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
