<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_share_detail_gradient"
    android:focusableInTouchMode="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="56dp">
        <ImageButton android:id="@+id/backButton" style="@style/Widget.Pm.PageLeadingAction"
            android:contentDescription="@string/cd_back" android:src="@drawable/ic_back_24"
            app:tint="#1E293B" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/playlist_edit_title" android:textSize="17sp" android:textStyle="bold"
            android:textColor="#1E293B" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/formScroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="@dimen/pm_page_content_start"
            android:paddingTop="20dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false">
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/coverView"
                    android:layout_width="112dp" android:layout_height="112dp" android:scaleType="centerCrop"
                    android:contentDescription="@string/playlist_edit_cover" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PlaylistEdit.Cover" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/coverButton"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:text="@string/playlist_edit_cover" android:textColor="@android:color/white"
                        android:paddingHorizontal="20dp" android:minWidth="0dp" app:cornerRadius="24dp"
                        app:backgroundTint="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/nameLayout"
                style="@style/Widget.PlaylistEdit.Input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:hint="@string/playlist_edit_name" app:counterEnabled="true" app:counterMaxLength="50">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/nameInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences" android:gravity="top|start"
                    android:lines="2" android:imeOptions="actionDone"
                    android:textSize="15sp" android:textColor="@color/listen_together_field_value" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/descriptionLayout"
                style="@style/Widget.PlaylistEdit.Input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:hint="@string/playlist_edit_description" app:counterEnabled="true" app:counterMaxLength="500">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/descriptionInput"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences" android:gravity="top|start"
                    android:minLines="3" android:textSize="15sp"
                    android:textColor="@color/listen_together_field_value" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/saveButton"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp"
                android:text="@string/playlist_edit_save" android:textColor="@android:color/white"
                app:cornerRadius="24dp" app:backgroundTint="?attr/colorPrimary" app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
