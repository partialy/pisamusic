<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/localMusicScanRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <View
        android:id="@+id/localMusicScanStatusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/home_page_bg" />

    <LinearLayout
        android:id="@+id/scanHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pm_page_content_start"
        android:paddingEnd="18dp">

        <ImageButton
            android:id="@+id/scanCloseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="10dp"
            android:src="@drawable/ic_close_24dp"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/scanTitleText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:gravity="center_vertical"
            android:text="@string/local_music_scan_songs"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/scanContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/scanInitialContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.55" />

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp">

                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_local_music_scan_circle_outer" />

                <View
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_local_music_scan_circle_middle" />

                <View
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_local_music_scan_circle_primary" />

                <FrameLayout
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_local_music_scan_circle_center">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/placeholder_music_note"
                        android:textColor="@color/primary"
                        android:textSize="48sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/scanIntroText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/local_music_scan_intro"
                android:textColor="?attr/colorOnSurface"
                android:textSize="23sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.45" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startScanButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/local_music_scan_start"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/blue_selected"
                app:cornerRadius="28dp" />

            <LinearLayout
                android:id="@+id/scanActionRow"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/customScanButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/local_music_scan_custom"
                    android:textColor="@color/blue_selected"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scanFilterButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/local_music_scan_filter_settings"
                    android:textColor="@color/blue_selected"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="28dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scanLoadingContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/local_music_scan_running"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scanResultContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/scanResultSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/pm_page_content_start"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scanResultRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/scanEmptyView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/local_music_scan_empty"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/scanImportBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_page_bg"
        android:paddingHorizontal="@dimen/pm_page_content_start"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanImportButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/local_music_scan_import"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/blue_selected"
            app:cornerRadius="26dp" />
    </FrameLayout>
</LinearLayout>
