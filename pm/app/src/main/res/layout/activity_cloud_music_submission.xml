<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cloudMusicSubmissionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    tools:context=".activity.CloudMusicSubmissionActivity">

    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/home_header_bg" />

    <LinearLayout
        android:id="@+id/cloudMusicSubmissionHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_header_bar_height"
        android:background="@color/home_header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/cloudMusicSubmissionBackButton"
            style="@style/Widget.Pm.PageLeadingAction"
            android:contentDescription="@string/cloud_music_back"
            android:src="@drawable/ic_back_24"
            app:tint="@color/home_tab_selected" />

        <LinearLayout
            android:id="@+id/submissionTabsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/submissionSubmitTabContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/submissionSubmitTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cloud_music_submission_submit_tab"
                    android:textColor="@color/home_tab_selected"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/submissionSubmitTabUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/home_tab_selected"
                    android:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/submissionHistoryTabContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/submissionHistoryTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cloud_music_submission_history_tab"
                    android:textColor="@color/home_tab_unselected"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/submissionHistoryTabUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/home_tab_selected"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cloudMusicSubmissionContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/submissionLoginState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/pm_page_content_start"
            android:paddingVertical="20dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cloud_music_summary"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="36dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_feedback_type_account"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/cloud_music_submission_login_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/cloud_music_submission_login_detail"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submissionLoginButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/cloud_music_submission_login_action"
                    android:textColor="@color/action_primary_text"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="25dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/submissionSelectFilesState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/pm_page_content_start"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/pm_page_content_start"
            android:paddingBottom="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. 音频文件上传区 (必选 *) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_music_submission_audio_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/feedback_required_mark"
                        android:textColor="@color/feedback_required_mark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/cloud_music_submission_audio_hint"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <!-- 未选态：虚线方框 -->
                    <LinearLayout
                        android:id="@+id/submissionAudioPickBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_feedback_pick_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_audio_quality_24"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/cloud_music_submission_select_audio"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/cloud_music_submission_audio_formats_hint"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 已选态：预览展示卡片 -->
                    <FrameLayout
                        android:id="@+id/submissionAudioPreviewBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_feedback_image_preview"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="96dp"
                        android:padding="14dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="32dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_cloud_music_summary">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_audio_quality_24"
                                    app:tint="?attr/colorPrimary" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/submissionAudioNameText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="middle"
                                    android:maxLines="2"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textStyle="bold"
                                    tools:text="sample.flac" />

                                <TextView
                                    android:id="@+id/submissionAudioMetaText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    tools:text="audio/flac · 28.5 MB" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/submissionAudioDeleteButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_feedback_image_delete"
                            android:contentDescription="@string/cloud_music_submission_clear"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_close_24dp"
                            app:tint="@android:color/white" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 2. 封面图片上传区 (选填) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_music_submission_cover_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/cloud_music_submission_cover_hint"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <!-- 未选态：虚线方框 104dp x 104dp -->
                    <LinearLayout
                        android:id="@+id/submissionCoverPickBox"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@drawable/bg_feedback_pick_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_plus_24"
                            app:tint="@color/feedback_pick_button_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/cloud_music_submission_upload_cover"
                            android:textColor="@color/feedback_pick_button_icon"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 已选态：直接展示那张图片，支持预览和去除 -->
                    <FrameLayout
                        android:id="@+id/submissionCoverPreviewBox"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@drawable/bg_feedback_image_preview"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:focusable="true"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/submissionCoverImageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/cloud_music_submission_cover_preview"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                        <ImageButton
                            android:id="@+id/submissionCoverDeleteButton"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_feedback_image_delete"
                            android:contentDescription="@string/cloud_music_submission_clear"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_close_24dp"
                            app:tint="@android:color/white" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 3. 歌词文件上传区 (选填) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_music_submission_lyrics_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/cloud_music_submission_lyrics_hint"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <!-- 未选态：虚线方框 -->
                    <LinearLayout
                        android:id="@+id/submissionLyricsPickBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_feedback_pick_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_settings_row_lyrics_24"
                            app:tint="@color/feedback_pick_button_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/cloud_music_submission_select_lyrics"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/cloud_music_submission_lyrics_formats_hint"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 已选态：歌词展示卡片 -->
                    <FrameLayout
                        android:id="@+id/submissionLyricsPreviewBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_feedback_image_preview"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="88dp"
                        android:padding="14dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="32dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_cloud_music_summary">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_settings_row_lyrics_24"
                                    app:tint="?attr/colorPrimary" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/submissionLyricsNameText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="middle"
                                    android:maxLines="2"
                                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textStyle="bold"
                                    tools:text="sample_lyrics.lrc" />

                                <TextView
                                    android:id="@+id/submissionLyricsMetaText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    tools:text="text/plain · 4.2 KB" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/submissionLyricsDeleteButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_feedback_image_delete"
                            android:contentDescription="@string/cloud_music_submission_clear"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_close_24dp"
                            app:tint="@android:color/white" />
                    </FrameLayout>
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submissionUploadExtractButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="28dp"
                    android:text="@string/cloud_music_submission_upload_extract"
                    android:textColor="@color/action_primary_text"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="25dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/submissionUploadingState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/submissionUploadPhaseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/cloud_music_submission_uploading_audio"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/submissionUploadFileNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="sample.flac" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/submissionUploadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="@color/cloud_music_summary_bg" />

            <TextView
                android:id="@+id/submissionUploadPercentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:text="@string/cloud_music_submission_percent_zero"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/submissionEditorState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/pm_page_content_start"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/pm_page_content_start"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <include layout="@layout/include_cloud_music_submission_editor" />
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/submissionSuccessState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/pm_page_content_start"
            android:paddingVertical="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cloud_music_summary"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="36dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_check_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/cloud_music_submission_success_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/cloud_music_submission_success_detail"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submissionContinueButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/cloud_music_submission_continue"
                    android:textColor="@color/action_primary_text"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="25dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submissionViewHistoryButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/cloud_music_submission_view_history"
                    app:cornerRadius="25dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/submissionHistoryState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/submissionHistorySwipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/submissionHistoryRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/pm_page_content_start"
                    android:paddingTop="16dp"
                    android:paddingEnd="@dimen/pm_page_content_start"
                    android:paddingBottom="72dp"
                    android:scrollbars="vertical"
                    tools:listitem="@layout/item_cloud_music_submission_history" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/submissionHistoryFullState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/home_page_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/submissionHistoryLoadingIndicator"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="@color/cloud_music_summary_bg" />

                <TextView
                    android:id="@+id/submissionHistoryStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cloud_music_submission_history_empty"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submissionHistoryRetryButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/cloud_music_submission_history_retry"
                    android:visibility="gone"
                    app:cornerRadius="24dp"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submissionHistoryEmptyAction"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/cloud_music_submission_history_start_first"
                    android:textColor="@color/action_primary_text"
                    android:visibility="gone"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="24dp"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/submissionHistoryFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/cloud_music_submission_footer_bg"
                android:gravity="center"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/pm_page_content_start"
                android:paddingVertical="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/submissionHistoryFooterProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:indeterminate="true"
                    app:indicatorColor="?attr/colorPrimary"
                    app:indicatorSize="24dp"
                    app:trackThickness="2dp" />

                <TextView
                    android:id="@+id/submissionHistoryFooterText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/cloud_music_submission_history_loading_more"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submissionHistoryFooterRetryButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:text="@string/cloud_music_submission_history_retry"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
