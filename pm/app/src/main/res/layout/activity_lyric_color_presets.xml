<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/colorManagerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_account_login_gradient"
    android:orientation="vertical">

    <!-- 透明顶栏：< 返回 | 颜色管理 | 更多/完成 -->
    <FrameLayout
        android:id="@+id/colorManagerHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/colorManagerBack"
            style="@style/Widget.Pm.PageLeadingAction"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back_24"
            app:tint="@color/account_login_text_primary" />

        <TextView
            android:id="@+id/colorManagerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="64dp"
            android:text="@string/lyric_color_manager_title"
            android:textColor="@color/account_login_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/colorManagerMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert_24"
            app:tint="@color/account_login_text_primary" />

        <TextView
            android:id="@+id/colorManagerDone"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/lyric_color_manager_done"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/colorManagerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="4dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/colorGroupsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
