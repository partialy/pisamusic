<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    android:orientation="vertical">

    <!-- 顶部固定区域：搜索框与数据统计（滚动列表时保持不动） -->
    <LinearLayout
        android:id="@+id/cloudMusicFixedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <!-- 胶囊搜索框（使用搜索界面的那种小的胶囊搜索框，带清除按钮） -->
        <LinearLayout
            android:id="@+id/cloudMusicSearchField"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_search_field"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:alpha="0.55"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search_black_24dp"
                app:tint="@color/home_tab_unselected" />

            <EditText
                android:id="@+id/cloudMusicSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/cloud_music_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/cloudMusicClearSearchButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cloud_music_clear_search"
                android:padding="6dp"
                android:src="@drawable/ic_close_24dp"
                android:visibility="gone"
                app:tint="@color/home_tab_unselected" />
        </LinearLayout>

        <!-- 搜索框下一行：小字次要颜色，高度较低：共享歌曲n首     2026-8-23更新+{投稿按钮}（小型的） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cloudMusicSummaryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cloudMusicSubmitButton"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_cloud_music_submit_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/cloud_music_submit"
                android:textColor="@color/action_primary_text"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 下方歌曲列表：滚动时候搜索框和数据统计区域不动 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/cloudMusicSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cloudMusicRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="20dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
