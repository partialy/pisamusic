<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_radius_sheet"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/announcementTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/announcement_system_title"
            android:textColor="@color/pm_dialog_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/announcementMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/home_mini_player_subtitle"
            android:textSize="12sp"
            tools:text="PisaMusic · 刚刚" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/announcementScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/announcementContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gotoButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/announcement_goto"
            android:textColor="@color/action_primary_text"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="24dp"
            tools:visibility="visible" />

        <Space
            android:id="@+id/buttonSpacer"
            android:layout_width="12dp"
            android:layout_height="1dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/announcement_confirm_default"
            android:textColor="@color/action_secondary_text"
            android:textStyle="bold"
            app:backgroundTint="@color/action_secondary_background"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
