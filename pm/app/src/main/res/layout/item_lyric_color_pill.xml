<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="36dp"
    android:layout_weight="1"
    android:background="@drawable/bg_lyric_color_pill"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingEnd="4dp">

    <View
        android:id="@+id/colorPillDot"
        android:layout_width="16dp"
        android:layout_height="16dp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/colorPillHex"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="2dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/account_login_text_primary"
        android:textSize="12sp"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform" />

    <ImageButton
        android:id="@+id/colorPillDelete"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close_24dp"
        app:tint="@color/account_login_text_hint" />
</LinearLayout>
