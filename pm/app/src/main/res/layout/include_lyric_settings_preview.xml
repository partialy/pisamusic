<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:background="@drawable/bg_lyric_settings_preview"
    android:clipToOutline="true"
    android:contentDescription="@string/lyric_settings_preview_description"
    android:descendantFocusability="blocksDescendants"
    android:importantForAccessibility="yes">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/previewNormalLyrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <cn.partialy.pm.ui.player.KaraokeLyricsView
        android:id="@+id/previewKaraokeLyrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants"
        android:visibility="gone" />

    <!-- 吞掉子歌词手势；父级 Sheet 仍可按正常拦截规则处理下滑关闭。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no" />
</FrameLayout>
