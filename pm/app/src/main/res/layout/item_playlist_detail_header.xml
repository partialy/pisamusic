<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/home_page_bg">

    <FrameLayout
        android:id="@+id/heroArtworkContainer"
        android:layout_width="0dp"
        android:layout_height="340dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/heroCoverImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_playlist_detail_hero_top_scrim" />

        <View
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_playlist_detail_hero_bottom_fade" />
    </FrameLayout>

    <TextView
        android:id="@+id/playlistTitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pm_page_content_start"
        android:layout_marginEnd="@dimen/pm_page_content_start"
        android:layout_marginBottom="18dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/heroArtworkContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/playlistDescTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pm_page_content_start"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/pm_page_content_start"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heroArtworkContainer" />

    <LinearLayout
        android:id="@+id/headerButtonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pm_page_content_start"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/pm_page_content_start"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlistDescTextView"
        app:layout_goneMarginTop="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/headerPlayAllButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_listen_together_create_button"
            android:stateListAnimator="@null"
            android:text="@string/play_all"
            android:textColor="@color/listen_together_create_button_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_play_24"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/listen_together_create_button_text"
            app:rippleColor="#33FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/headerCollectButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_listen_together_create_card"
            android:stateListAnimator="@null"
            android:text="@string/collect_playlist"
            android:textColor="@color/home_tab_selected"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_love_24"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/home_tab_selected"
            app:rippleColor="#1A000000" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlistSearchBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/pm_page_content_start"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerButtonsContainer">

        <EditText
            android:id="@+id/playlistSearchInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_listen_together_create_card"
            android:hint="@string/playlist_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/playlistSearchCancelText"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/blue_selected" />
    </LinearLayout>

    <View
        android:id="@+id/headerBottomSpacer"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/home_page_bg"
        app:layout_constraintTop_toBottomOf="@id/playlistSearchBarLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
