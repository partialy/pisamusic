<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusableInTouchMode="true"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/linkInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp"
        app:boxStrokeColor="@color/pm_dialog_confirm"
        app:endIconMode="custom"
        app:errorIconDrawable="@null"
        app:endIconCheckable="false"
        app:endIconDrawable="@drawable/ic_paste_24"
        app:endIconContentDescription="@string/playlist_link_paste"
        app:endIconTint="@color/pm_dialog_confirm">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/linkInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/playlist_link_hint"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="3"
            android:maxLines="5"
            android:scrollbars="vertical"
            android:paddingHorizontal="12dp"
            android:textColor="@color/pm_dialog_title"
            android:textColorHint="@color/pm_dialog_message"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
